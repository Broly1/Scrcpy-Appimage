#!/bin/bash

# Get the path to the AppImage internal directory
HERE="$(dirname "$(readlink -f "${0}")")"
MODULE="v4l2loopback"
WANTED_NAME="Android_Webcam_v4l2"
SPECIFIC_NR="128"

cleanup() {
    echo "Cleaning up..."
    # Kill any hung scrcpy processes to free the video device
    killall scrcpy 2>/dev/null || true
}
trap cleanup EXIT

# Check if the module is currently loaded in the kernel
MODULE_LOADED=$(lsmod | grep -q "$MODULE" && echo "yes" || echo "no")
# Check if the label is already correctly set
CURRENT_LABEL=$(cat /sys/class/video4linux/video*/name 2>/dev/null | grep "$WANTED_NAME" || echo "")

if [ "$MODULE_LOADED" = "no" ] || [ "$CURRENT_LABEL" != "$WANTED_NAME" ]; then
    echo "Virtual Camera needs configuration. Requesting authentication..."

    # If it's loaded with the wrong label, we must remove it first
    if [ "$MODULE_LOADED" = "yes" ]; then
        CMD="modprobe -r $MODULE && modprobe $MODULE exclusive_caps=1 card_label='$WANTED_NAME' video_nr=$SPECIFIC_NR"
    else
        CMD="modprobe $MODULE exclusive_caps=1 card_label='$WANTED_NAME' video_nr=$SPECIFIC_NR"
    fi

    # Run the command. This will only trigger if necessary.
    if ! pkexec sh -c "$CMD"; then
        echo "ERROR: Authentication failed or modprobe failed."
        exit 1
    fi
fi

# Automatically find the V4L2 device ID ---
VIDEO_DEV=$(v4l2-ctl --list-devices 2>/dev/null | grep -A1 "$WANTED_NAME" | grep -o "/dev/video[0-9]*" | head -n1)
IF_SINK=${VIDEO_DEV:-/dev/video$SPECIFIC_NR}

echo "Targeting V4L2 Sink: $IF_SINK"

# Detect Camera Capabilities using the INTERNAL scrcpy ---
echo "Detecting Rear Camera capabilities..."
RAW_INFO=$("$HERE/scrcpy" --video-source=camera --camera-facing=back --list-camera-sizes 2>&1)

# --- Check if ADB device is actually connected ---
if echo "$RAW_INFO" | grep -q "Could not find any ADB device"; then
    echo "-------------------------------------------------------"
    echo "ERROR: NO PHONE DETECTED"
    echo "Check USB cable and ensure USB Debugging is ON."
    echo "-------------------------------------------------------"
    exit 1
fi

# Logic: Select Best Resolution ---
if echo "$RAW_INFO" | grep -q "1920x1080"; then
    BEST_RES="1920x1080"
elif echo "$RAW_INFO" | grep -q "1280x720"; then
    BEST_RES="1280x720"
else
    # Fallback logic if 1080p or 720p aren't standard
    BEST_RES=$(echo "$RAW_INFO" | grep -oE '[0-9]+x[0-9]+' | awk -F'x' '$1 <= 1920 {print $1*$2, $0}' | sort -nr | head -n1 | cut -d' ' -f2)
fi

# Ensure we actually found a resolution before proceeding
if [ -z "$BEST_RES" ]; then
    echo "ERROR: Could not determine a valid camera resolution."
    exit 1
fi

echo "Stable Mode: $BEST_RES @ 30 FPS"

# Execute scrcpy with the detected parameters
exec "$HERE/scrcpy" \
    --video-source=camera \
    --camera-facing=back \
    --camera-size="$BEST_RES" \
    --camera-fps=30 \
    --video-bit-rate=10M \
    --video-codec=h264 \
    --v4l2-sink="$IF_SINK" \
    --v4l2-buffer=0 \
    --window-title="Webcam: $BEST_RES @ 30fps" \
    "$@"
